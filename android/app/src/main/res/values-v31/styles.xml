<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ replaces windowBackground with a system splash screen.
         Force a white splash background; the icon defaults to the launcher
         icon (the Guardify shield). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
    </style>
</resources>
